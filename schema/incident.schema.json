{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AASIC incident record",
  "type": "object",
  "required": [
    "id",
    "title",
    "event_date",
    "disclosure_date",
    "record_class",
    "provider",
    "agent",
    "context",
    "attempt",
    "boundary_crossing",
    "effect",
    "harm",
    "harm_confirmed",
    "causal_attribution",
    "actor_attribution",
    "summary",
    "confirmed",
    "unresolved",
    "sources",
    "research_tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AASIC-[0-9]{3}$"
    },
    "record_class": {
      "enum": [
        "confirmed_real_world",
        "controlled_with_real_external_effect",
        "partial_attribution_real_world",
        "controlled_boundary_crossing",
        "controlled_misalignment_no_external_effect",
        "experimental_only"
      ]
    },
    "causal_attribution": {
      "enum": [
        "strong",
        "moderate",
        "weak",
        "unconfirmed"
      ]
    },
    "actor_attribution": {
      "enum": [
        "confirmed",
        "strong",
        "partial",
        "unconfirmed"
      ]
    },
    "attempt": {
      "type": "boolean"
    },
    "boundary_crossing": {
      "type": "boolean"
    },
    "effect": {
      "type": "boolean"
    },
    "harm_confirmed": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    }
  }
}