{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AASIC incident record",
  "type": "object",
  "required": [
    "id",
    "title",
    "event_date",
    "disclosure_date",
    "record_class",
    "provider",
    "agent",
    "context",
    "attempt",
    "boundary_crossing",
    "effect",
    "harm",
    "harm_confirmed",
    "causal_attribution",
    "actor_attribution",
    "summary",
    "confirmed",
    "unresolved",
    "sources",
    "research_tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AASIC-[0-9]{3}$"
    },
    "record_class": {
      "enum": [
        "confirmed_real_world",
        "controlled_with_real_external_effect",
        "partial_attribution_real_world",
        "controlled_boundary_crossing",
        "controlled_misalignment_no_external_effect",
        "experimental_only"
      ]
    },
    "causal_attribution": {
      "enum": [
        "strong",
        "moderate",
        "weak",
        "unconfirmed"
      ]
    },
    "actor_attribution": {
      "enum": [
        "confirmed",
        "strong",
        "partial",
        "unconfirmed"
      ]
    },
    "attempt": {
      "type": "boolean"
    },
    "boundary_crossing": {
      "type": "boolean"
    },
    "effect": {
      "type": "boolean"
    },
    "harm_confirmed": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "model_behavior_during_evaluation",
        "production_agent_operation",
        "agent_operational_failure",
        "simulation_only",
        "human_directed_agent_misuse",
        "unknown"
      ]
    },
    "episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "aggregation_note": {
      "type": "string"
    },
    "effect_characterization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_action",
        "external_effect",
        "impact_status",
        "compromise_status",
        "notes"
      ],
      "properties": {
        "observable_action": {
          "type": "boolean"
        },
        "external_effect": {
          "type": "boolean"
        },
        "impact_status": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ]
        },
        "compromise_status": {
          "enum": [
            "not_observed",
            "confirmed",
            "unconfirmed",
            "not_applicable",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
